{
  "name": "my-first-fullstack-site",
  "private": true,
  "version": "0.1.0",
  "workspaces": ["apps/*"],
  "scripts": {
    "dev": "concurrently -n WEB,API -c blue,green \"npm run dev -w web\" \"npm run start:dev -w api\"",
    "build": "npm run build -w web && npm run build -w api",
    "db:generate": "npm run db:generate -w api",
    "db:migrate": "npm run db:migrate -w api",
    "db:studio": "npm run db:studio -w api",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down"
  },
  "devDependencies": { "concurrently": "^9.2.1" },
  "engines": { "node": ">=22.12" }
}
